{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "write-ai-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "writeai.center",
      "custom_domain": true
    },
    {
      "pattern": "www.writeai.center",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
